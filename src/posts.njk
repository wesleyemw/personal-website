<h1>Posts</h1>

<ul class="featured article-list">
{%- for post in collections.post | reverse -%}
  <li class="article-item">        
        <h4><a href="{{ post.url }}">{{ post.data.title }}</a></h4>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
        <p class="article-meta">
          <time datetime="{{ post.date }}">{{ post.date | postDate }}</time>
        </p>   
  </li>
{%- endfor -%}
</ul>