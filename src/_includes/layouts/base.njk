<!DOCTYPE html>
<html lang="{{ labels.shorthand }}" dir="{{ labels.dir or 'ltr' }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="generator" content="{{ eleventy.generator }}"/>
        <meta name="color-scheme" content="light dark" />
        <meta name="description"  content="{{ labels.siteDescription }}" />
        <title>{{ title }}</title>

        <!-- opengraph tags -->
        <meta property="og:site_name" content="{{ meta.siteName }}" />
        <meta property="og:title" content="{{ title }} | {{ meta.siteName }}" />
        <meta property="og:type" content="website" />
        <meta property="og:description" content="{{ labels.siteDescription }}"/>
        <meta property="og:url" content="{{ meta.url }}{{ page.url }}" />
        <meta property="og:locale" content="{{ labels.locale }}" />
        {% for link in page.url %}
        <meta property="og:image" content="{{ meta.url }}{{ labels.ogImageUrl }}" />
        {% endfor %}
        <!-- opengraph tags -->

        <link rel="alternate" hreflang="{{ labels.shorthand }}" href="{{ meta.url }}{{ page.url }}">
        
        <link rel="icon" href="{{ '/assets/images/favicon.svg' | url }}" type="image/svg+xml" />
        <link href="{{ '/assets/css/main.css' | url }}" rel="stylesheet"/>

        <!-- mastodon verification link -->
        <a rel="me" href="https://hachyderm.io/@wesley_soares">Mastodon</a>
        <script src="{{ '/assets/js/app.js' | url }}" type="module"></script>
    </head>
    <body data-theme="light">
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="0" height="0" style="contain: strict; position: absolute;">
            <pattern id="pattern-32" patternUnits="userSpaceOnUse" width="6" height="6">
                <circle cx="3" cy="3" r="1" fill="currentcolor" style="fill: var(--pattern-channel-1, currentcolor)" />
            </pattern>
        </svg>

        {% include 'layouts/partials/header.njk' %}
        
        {{ content | safe }}
        
        {% include 'layouts/partials/footer.njk' %}
        
    </body>
</html>