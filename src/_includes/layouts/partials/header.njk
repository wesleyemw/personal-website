<a href="#main" class="sr-only">{{ labels.skipText }}</a>
<header>
    <a href="{{ "/" }}">
        <img src="{{ meta.logoImg }}" alt="Logo">
        <span>Wesley Soares</span>
    </a>

    <nav aria-label="labels.ariaLabel">
        <ul>
            {# <li><a href="{{ '/posts/' | locale_url }}">posts</a></li>
                                                                                                <li><a href="{{ '/about/' | locale_url }}">about</a></li> #}
            {% for item in navigation.items %}
                <li>
                    <a href="{{ item.url | safe }}">{{ item.text }}</a>
                </li>
            {% endfor %}
        </ul>
    </nav>
</header>